#!/usr/bin/env bash

set -euo pipefail

echo "[agent-skills] Installing agent skills from github/agent-config repository"

# Define directories
TEMP_DIR=$(mktemp -d)
trap 'rm -rf -- "${TEMP_DIR}"' EXIT
SKILLS_REPO="https://github.com/github/agent-config.git"
TARGET_DIR="${HOME}/.copilot/skills"

# Clone the github/agent-config repository
echo "[agent-skills] Cloning github/agent-config repository..."
if ! git clone --depth=1 "${SKILLS_REPO}" "${TEMP_DIR}"; then
    echo "[agent-skills] Error: Failed to clone github/agent-config repository"
    echo "[agent-skills] Please check your network connection and try again"
    exit 1
fi

# Create target directory
echo "[agent-skills] Creating target directory: ${TARGET_DIR}"
mkdir -p "${TARGET_DIR}"

# Copy all skills from the repository
if [[ -d "${TEMP_DIR}/skills" ]]; then
    echo "[agent-skills] Copying skills to ${TARGET_DIR}..."
    
    # Count total skills
    SKILL_COUNT=$(find "${TEMP_DIR}/skills" -mindepth 1 -maxdepth 1 -type d | wc -l)
    echo "[agent-skills] Found ${SKILL_COUNT} skills to install"
    
    # Copy each skill directory
    for skill_dir in "${TEMP_DIR}/skills"/*; do
        if [[ -d "${skill_dir}" ]]; then
            skill_name=$(basename "${skill_dir}")
            echo "[agent-skills]   - Installing: ${skill_name}"
            rm -rf "${TARGET_DIR:?}/${skill_name:?}"
            if ! cp -r "${skill_dir}" "${TARGET_DIR}/${skill_name}"; then
                echo "[agent-skills] Error: Failed to copy skill '${skill_name}'"
                echo "[agent-skills] Please check permissions and disk space"
                exit 1
            fi
        fi
    done
    
    echo "[agent-skills] Successfully installed ${SKILL_COUNT} skills"
else
    echo "[agent-skills] Error: Skills directory not found in cloned repository"
    exit 1
fi

# Clean up temp directory (also handled by the EXIT trap; explicit for clarity)
echo "[agent-skills] Cleaning up temp directory"
rm -rf -- "${TEMP_DIR}"

# List installed skills
echo "[agent-skills] Installed skills:"
ls -1 "${TARGET_DIR}"

echo "[agent-skills] Agent skills installation complete!"

echo "[agent-skills] Installing gh-hubber-skills extension..."
if ! gh extension install github/gh-hubber-skills; then
    echo "[agent-skills] Error: Failed to install gh-hubber-skills extension"
    echo "[agent-skills] Please check your network connection and gh authentication"
    exit 1
fi
if ! gh hubber-skills install --all; then
    echo "[agent-skills] Error: Failed to run 'gh hubber-skills install --all'"
    exit 1
fi
echo "[agent-skills] gh-hubber-skills installation complete!"
