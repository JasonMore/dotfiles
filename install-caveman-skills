#!/usr/bin/env bash

set -euo pipefail

echo "[caveman-skills] Installing caveman skills from JuliusBrussee/caveman"

TEMP_DIR=$(mktemp -d)
SKILLS_REPO="https://github.com/JuliusBrussee/caveman.git"
TARGET_DIR="${HOME}/.agents/skills"

echo "[caveman-skills] Cloning JuliusBrussee/caveman..."
if ! git clone --depth=1 "${SKILLS_REPO}" "${TEMP_DIR}"; then
    echo "[caveman-skills] Error: Failed to clone repository"
    rm -rf "${TEMP_DIR}"
    exit 1
fi

mkdir -p "${TARGET_DIR}"

if [[ -d "${TEMP_DIR}/skills" ]]; then
    for skill_dir in "${TEMP_DIR}/skills"/*; do
        if [[ -d "${skill_dir}" ]]; then
            skill_name=$(basename "${skill_dir}")
            echo "[caveman-skills]   - Installing: ${skill_name}"
            rm -rf "${TARGET_DIR}/${skill_name}"
            cp -r "${skill_dir}" "${TARGET_DIR}/${skill_name}"
        fi
    done
    echo "[caveman-skills] Done"
else
    echo "[caveman-skills] Error: skills/ directory not found in repo"
    rm -rf "${TEMP_DIR}"
    exit 1
fi

rm -rf "${TEMP_DIR}"
