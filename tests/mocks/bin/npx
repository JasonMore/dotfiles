#!/usr/bin/env bash
# Test mock for global skill installers.
set -euo pipefail
if [[ "${MOCK_NPX_FAIL:-0}" == "1" ]]; then
	echo "[mock-npx] simulated failure for: $*" >&2
	exit 1
fi
echo "[mock-npx] $*"
if [[ "${1:-}" == "--yes" && "${2:-}" == "impeccable" ]]; then
	if [[ "${MOCK_IMPECCABLE_FAIL:-0}" == "1" ]]; then
		echo "[mock-npx] simulated Impeccable failure" >&2
		exit 1
	fi
	if [[ "$*" != "--yes impeccable install --providers=codex --scope=global --no-hooks --yes" ]]; then
		echo "[mock-npx] unexpected Impeccable install flags" >&2
		exit 1
	fi
	if [[ "${MOCK_IMPECCABLE_MISSING_SKILL:-0}" != "1" ]]; then
		mkdir -p "${HOME}/.agents/skills/impeccable"
		printf '# Impeccable\n' > "${HOME}/.agents/skills/impeccable/SKILL.md"
	fi
fi
exit 0
