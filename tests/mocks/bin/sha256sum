#!/usr/bin/env bash
set -euo pipefail

if [[ "$*" != "--check --status" ]]; then
	echo "[mock-sha256sum] unexpected command: $*" >&2
	exit 1
fi
if [[ "${MOCK_MERGIRAF_CHECKSUM_FAIL:-0}" == "1" ]]; then
	echo "[mock-sha256sum] simulated checksum mismatch" >&2
	exit 1
fi

case "${MOCK_UNAME_ARCH:-x86_64}" in
	x86_64) expected="fc77469be936b02ab9021b984a3aebc9250a21ae3d264f2ef2198eb8b31b2a7b" ;;
	aarch64 | arm64) expected="0f153dfa85a799c0d05ee7a21834d049b3595e367ed411a56f007bdb5de8c19d" ;;
	*) echo "[mock-sha256sum] unexpected architecture" >&2; exit 1 ;;
esac
IFS= read -r entry
if [[ "${entry}" != "${expected}  "* || ! -s "${entry#*  }" ]]; then
	echo "[mock-sha256sum] unexpected checksum or missing archive" >&2
	exit 1
fi
