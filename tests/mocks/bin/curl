#!/usr/bin/env bash
# Test mock for the Atuin setup script and Mergiraf release downloads.
# Everything else is unexpected in tests and fails loudly.
set -euo pipefail

url=""
output_path=""
previous=""
for arg in "$@"; do
	if [[ "${previous}" == "--output" ]]; then
		output_path="${arg}"
	fi
	case "${arg}" in
		http*) url="${arg}" ;;
	esac
	previous="${arg}"
done

if [[ "${url}" == https://codeberg.org/mergiraf/mergiraf/releases/download/* ]]; then
	if [[ "${MOCK_CURL_MERGIRAF_FAIL:-0}" == "1" ]]; then
		echo "[mock-curl] simulated Mergiraf download failure" >&2
		exit 1
	fi
	case "${MOCK_UNAME_ARCH:-x86_64}" in
		x86_64) architecture="x86_64" ;;
		aarch64 | arm64) architecture="aarch64" ;;
		*) echo "[mock-curl] unexpected architecture" >&2; exit 1 ;;
	esac
	expected_url="https://codeberg.org/mergiraf/mergiraf/releases/download/v0.20.0/mergiraf_${architecture}-unknown-linux-musl.tar.gz"
	if [[ "${url}" != "${expected_url}" || -z "${output_path}" ]]; then
		echo "[mock-curl] unexpected Mergiraf release request: $*" >&2
		exit 1
	fi
	mock_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
	tar -czf "${output_path}" -C "${mock_dir}" mergiraf
	echo "[mock-curl] downloaded Mergiraf for ${architecture}"
	exit 0
fi

if [[ "${url}" == *setup.atuin.sh* ]]; then
	if [[ "${MOCK_CURL_ATUIN_FAIL:-0}" == "1" ]]; then
		echo "[mock-curl] simulated network failure fetching ${url}" >&2
		exit 1
	fi

	mkdir -p "${HOME}/.atuin/bin"
	cat > "${HOME}/.atuin/bin/atuin" <<'ATUIN_SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "login" ]]; then
	echo "[mock-atuin] login called"
	if [[ "${MOCK_ATUIN_LOGIN_FAIL:-0}" == "1" ]]; then
		echo "[mock-atuin] login failed (simulated)" >&2
		exit 1
	fi
	echo "[mock-atuin] login succeeded"
	exit 0
fi
exit 0
ATUIN_SCRIPT
	chmod +x "${HOME}/.atuin/bin/atuin"

	cat > "${HOME}/.atuin/bin/env" <<'ENV_SCRIPT'
export PATH="${HOME}/.atuin/bin:${PATH}"
ENV_SCRIPT

	# This output becomes sh's stdin. Require the non-interactive argument
	# that avoids setup.atuin.sh's /dev/tty probe in Codespaces creation.
	cat <<'INSTALL_SCRIPT'
if [ "${1:-}" != "--non-interactive" ]; then
	echo "missing --non-interactive" >&2
	exit 42
fi
touch "${HOME}/.atuin/non-interactive-install"
INSTALL_SCRIPT
	exit 0
fi

echo "[mock-curl] unhandled invocation: $*" >&2
exit 1
