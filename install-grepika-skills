#!/usr/bin/env bash

set -euo pipefail

echo "[grepika-skills] Installing grepika skills from agentika-labs/grepika (upstream, not JasonMore/ai-skills)"

# Define directories
TEMP_DIR=$(mktemp -d)
SKILLS_REPO="https://github.com/agentika-labs/grepika.git"
SOURCE_DIR="${TEMP_DIR}/plugins/grepika/skills"
TARGET_DIR="${HOME}/.copilot/skills"

cleanup() {
	rm -rf -- "${TEMP_DIR}"
}
trap cleanup EXIT

# Clone the upstream grepika repository fresh each run so skills always
# reflect what agentika-labs currently ships. This repo (dotfiles) is not
# the source of truth for grepika skills, and JasonMore/ai-skills is
# Jason-authored skills only — neither should ever carry grepika content.
echo "[grepika-skills] Cloning agentika-labs/grepika..."
if ! git clone --depth=1 "${SKILLS_REPO}" "${TEMP_DIR}"; then
	echo "[grepika-skills] Error: Failed to clone agentika-labs/grepika"
	echo "[grepika-skills] Please check your network connection and try again"
	exit 1
fi

if [[ ! -d "${SOURCE_DIR}" ]]; then
	echo "[grepika-skills] Error: Expected skills directory not found at plugins/grepika/skills"
	echo "[grepika-skills] Upstream repo layout may have changed"
	exit 1
fi

mkdir -p "${TARGET_DIR}"

# Build the expected skill list up front (only dirs with a SKILL.md count
# as real skills) so we can verify installation completeness at the end.
expected_skills=()
for skill_dir in "${SOURCE_DIR}"/*/; do
	[[ -d "${skill_dir}" ]] || continue
	skill_name="$(basename "${skill_dir}")"
	if [[ -f "${skill_dir}/SKILL.md" ]]; then
		expected_skills+=("${skill_name}")
	else
		echo "[grepika-skills] Warning: ${skill_name} has no SKILL.md, skipping"
	fi
done

if [[ "${#expected_skills[@]}" -eq 0 ]]; then
	echo "[grepika-skills] Error: No valid skill directories (with SKILL.md) found under plugins/grepika/skills"
	exit 1
fi
echo "[grepika-skills] Found ${#expected_skills[@]} skills to install: ${expected_skills[*]}"

for skill_name in "${expected_skills[@]}"; do
	skill_dir="${SOURCE_DIR}/${skill_name}"
	echo "[grepika-skills]   - Installing: ${skill_name}"
	rm -rf -- "${TARGET_DIR}/${skill_name}"
	if ! cp -r "${skill_dir}" "${TARGET_DIR}/${skill_name}"; then
		echo "[grepika-skills] Error: Failed to copy skill '${skill_name}'"
		exit 1
	fi
done

# Verify every expected skill (including any references/ subdirectories,
# since cp -r copies each skill directory wholesale) actually landed in
# the global skills directory before declaring success.
echo "[grepika-skills] Verifying installed skills..."
missing_skills=()
for skill_name in "${expected_skills[@]}"; do
	if [[ ! -f "${TARGET_DIR}/${skill_name}/SKILL.md" ]]; then
		missing_skills+=("${skill_name}")
		continue
	fi
	source_file_count=$(find "${SOURCE_DIR}/${skill_name}" -type f | wc -l | tr -d ' ')
	target_file_count=$(find "${TARGET_DIR}/${skill_name}" -type f | wc -l | tr -d ' ')
	if [[ "${source_file_count}" != "${target_file_count}" ]]; then
		echo "[grepika-skills] Error: ${skill_name} file count mismatch (source=${source_file_count}, target=${target_file_count}); references may not have copied fully"
		missing_skills+=("${skill_name}")
	fi
done

if [[ "${#missing_skills[@]}" -gt 0 ]]; then
	echo "[grepika-skills] Error: Failed to verify skills: ${missing_skills[*]}"
	exit 1
fi

echo "[grepika-skills] Verified all ${#expected_skills[@]} grepika skills present in ${TARGET_DIR}:"
printf '[grepika-skills]   - %s\n' "${expected_skills[@]}"

echo "[grepika-skills] grepika skills installation complete!"
