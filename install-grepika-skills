#!/usr/bin/env bash

set -euo pipefail

# Upstream grepika skills are authored for Claude Code: their Markdown
# files (SKILL.md and any references/*.md they load) reference
# mcp__grepika__<tool> MCP tool names, ~/.claude/blueprints paths, and
# Claude slash-command/$ARGUMENTS syntax that don't exist in Copilot
# (Copilot exposes grepika-<tool> instead). Rewrite only the installed
# copy under ~/.copilot/skills so skills are actually usable with
# Copilot; never touch the upstream clone (it's discarded on exit) or
# JasonMore/ai-skills.
#
# Slash-command names are replaced explicitly (not a broad `/` -> ``
# strip, which could corrupt legitimate backticked absolute paths).
# Longer/more specific names are listed first so e.g. /index-status is
# never partially rewritten by the shorter /index rule.
#
# Each pattern also requires a non-path leading boundary
# ((^|[^A-Za-z0-9_./-])) in addition to the existing trailing boundary,
# so only a standalone slash-command token (start of line, or preceded
# by whitespace/backtick/punctuation) is rewritten. A `/` preceded by a
# path character -- letter, digit, underscore, dot, hyphen, or another
# slash, as in `src/index.ts` or `docs/index-status.md` -- never
# matches, so file paths are left untouched.
adapt_skill_for_copilot() {
	local file="$1"
	local tmp
	tmp="$(mktemp)"
	sed -E \
		-e 's/mcp__grepika__([a-zA-Z_]+)/grepika-\1/g' \
		-e 's#~/\.claude/blueprints#~/.copilot/blueprints#g' \
		-e 's/\$ARGUMENTS/(derive this from context; not a literal variable)/g' \
		-e 's#(^|[^A-Za-z0-9_./-])/index-status([^a-zA-Z0-9_-]|$)#\1index-status\2#g' \
		-e 's#(^|[^A-Za-z0-9_./-])/apply-pattern([^a-zA-Z0-9_-]|$)#\1apply-pattern\2#g' \
		-e 's#(^|[^A-Za-z0-9_./-])/study([^a-zA-Z0-9_-]|$)#\1study\2#g' \
		-e 's#(^|[^A-Za-z0-9_./-])/index([^a-zA-Z0-9_-]|$)#\1grepika-index\2#g' \
		"${file}" > "${tmp}"
	mv "${tmp}" "${file}"
}

main() {
	echo "[grepika-skills] Installing grepika skills from agentika-labs/grepika (upstream, not JasonMore/ai-skills)"

	# Define directories. TEMP_DIR is intentionally not `local`: the EXIT
	# trap below (a global function, since bash functions are never
	# scoped) fires after main() returns, so it needs TEMP_DIR to still be
	# set at that point.
	TEMP_DIR=$(mktemp -d)
	local SKILLS_REPO SOURCE_DIR TARGET_DIR
	SKILLS_REPO="https://github.com/agentika-labs/grepika.git"
	SOURCE_DIR="${TEMP_DIR}/plugins/grepika/skills"
	TARGET_DIR="${HOME}/.copilot/skills"

	cleanup() {
		rm -rf -- "${TEMP_DIR}"
	}
	trap cleanup EXIT

	# Clone the upstream grepika repository fresh each run so skills always
	# reflect what agentika-labs currently ships. This repo (dotfiles) is not
	# the source of truth for grepika skills, and JasonMore/ai-skills is
	# Jason-authored skills only; neither should ever carry grepika content.
	echo "[grepika-skills] Cloning agentika-labs/grepika..."
	if ! git clone --depth=1 "${SKILLS_REPO}" "${TEMP_DIR}"; then
		echo "[grepika-skills] Error: Failed to clone agentika-labs/grepika"
		echo "[grepika-skills] Please check your network connection and try again"
		exit 1
	fi

	if [[ ! -d "${SOURCE_DIR}" ]]; then
		echo "[grepika-skills] Error: Expected skills directory not found at plugins/grepika/skills"
		echo "[grepika-skills] Upstream repo layout may have changed"
		exit 1
	fi

	mkdir -p "${TARGET_DIR}"

	# Build the expected skill list up front (only dirs with a SKILL.md count
	# as real skills) so we can verify installation completeness at the end.
	local expected_skills=()
	local skill_dir skill_name
	for skill_dir in "${SOURCE_DIR}"/*/; do
		[[ -d "${skill_dir}" ]] || continue
		skill_name="$(basename "${skill_dir}")"
		if [[ -f "${skill_dir}/SKILL.md" ]]; then
			expected_skills+=("${skill_name}")
		else
			echo "[grepika-skills] Warning: ${skill_name} has no SKILL.md, skipping"
		fi
	done

	if [[ "${#expected_skills[@]}" -eq 0 ]]; then
		echo "[grepika-skills] Error: No valid skill directories (with SKILL.md) found under plugins/grepika/skills"
		exit 1
	fi
	echo "[grepika-skills] Found ${#expected_skills[@]} skills to install: ${expected_skills[*]}"

	for skill_name in "${expected_skills[@]}"; do
		skill_dir="${SOURCE_DIR}/${skill_name}"
		echo "[grepika-skills]   - Installing: ${skill_name}"
		rm -rf -- "${TARGET_DIR}/${skill_name}"
		if ! cp -r "${skill_dir}" "${TARGET_DIR}/${skill_name}"; then
			echo "[grepika-skills] Error: Failed to copy skill '${skill_name}'"
			exit 1
		fi
		# Adapt every Markdown file in the installed skill, not just
		# SKILL.md: references/*.md files (e.g. index-status's
		# troubleshooting.md) are also loaded by skills and can carry the
		# same Claude-only identifiers.
		while IFS= read -r -d '' md_file; do
			adapt_skill_for_copilot "${md_file}"
		done < <(find "${TARGET_DIR}/${skill_name}" -type f -name '*.md' -print0)
	done

	# Verify every expected skill (including any references/ subdirectories,
	# since cp -r copies each skill directory wholesale) actually landed in
	# the global skills directory before declaring success.
	echo "[grepika-skills] Verifying installed skills..."
	local missing_skills=()
	local source_file_count target_file_count
	for skill_name in "${expected_skills[@]}"; do
		if [[ ! -f "${TARGET_DIR}/${skill_name}/SKILL.md" ]]; then
			missing_skills+=("${skill_name}")
			continue
		fi
		source_file_count=$(find "${SOURCE_DIR}/${skill_name}" -type f | wc -l | tr -d ' ')
		target_file_count=$(find "${TARGET_DIR}/${skill_name}" -type f | wc -l | tr -d ' ')
		if [[ "${source_file_count}" != "${target_file_count}" ]]; then
			echo "[grepika-skills] Error: ${skill_name} file count mismatch (source=${source_file_count}, target=${target_file_count}); references may not have copied fully"
			missing_skills+=("${skill_name}")
		fi
		if grep -rlq 'mcp__grepika__' "${TARGET_DIR}/${skill_name}" --include='*.md' 2>/dev/null; then
			echo "[grepika-skills] Error: ${skill_name} still contains Claude-only mcp__grepika__ tool names after adaptation"
			missing_skills+=("${skill_name}")
		fi
		if grep -rlq '\.claude/blueprints' "${TARGET_DIR}/${skill_name}" --include='*.md' 2>/dev/null; then
			echo "[grepika-skills] Error: ${skill_name} still references ~/.claude/blueprints after adaptation"
			missing_skills+=("${skill_name}")
		fi
		if grep -rlq '\$ARGUMENTS' "${TARGET_DIR}/${skill_name}" --include='*.md' 2>/dev/null; then
			echo "[grepika-skills] Error: ${skill_name} still contains a literal \$ARGUMENTS placeholder after adaptation"
			missing_skills+=("${skill_name}")
		fi
		if grep -rlqE '(^|[^A-Za-z0-9_./-])/(index-status|apply-pattern|study|index)([^a-zA-Z0-9_-]|$)' "${TARGET_DIR}/${skill_name}" --include='*.md' 2>/dev/null; then
			echo "[grepika-skills] Error: ${skill_name} still contains an unadapted Claude slash-command reference"
			missing_skills+=("${skill_name}")
		fi
	done

	if [[ "${#missing_skills[@]}" -gt 0 ]]; then
		echo "[grepika-skills] Error: Failed to verify skills: ${missing_skills[*]}"
		exit 1
	fi

	echo "[grepika-skills] Verified all ${#expected_skills[@]} grepika skills present in ${TARGET_DIR}:"
	printf '[grepika-skills]   - %s\n' "${expected_skills[@]}"

	echo "[grepika-skills] grepika skills installation complete!"
}

# Only run main when executed directly (not when sourced), so tests can
# source this file to exercise adapt_skill_for_copilot() in isolation
# without cloning the network or touching ~/.copilot/skills.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
