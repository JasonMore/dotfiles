#!/usr/bin/env bash

set -euo pipefail

sudo chsh "$(id -un)" --shell "/usr/bin/zsh"

# Configure git so that 'git push' will automatically set up the remote tracking branch
echo "[dotfiles] Setting git config: push.autoSetupRemote = true"
git config --global push.autoSetupRemote true
git config --global pull.rebase false

# Configure global gitignore to exclude .idea folders
echo "[dotfiles] Setting up global gitignore"
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
git config --global core.excludesfile "${DOTFILES_DIR}/.gitignore_global"

# Tmux config
echo "[dotfiles] Linking tmux config"
ln -sf "${DOTFILES_DIR}/.tmux.conf" "${HOME}/.tmux.conf"

# workspace (git worktree helper)
echo "[dotfiles] Installing workspace script"
mkdir -p "${HOME}/.local/bin"
ln -sf "${DOTFILES_DIR}/workspace.sh" "${HOME}/.local/bin/workspace.sh"

if [[ -n "${CODESPACES}" ]]; then

	# oh-my-zsh (shell framework)
	if [[ -d "${HOME}/.oh-my-zsh" ]]; then
		echo "[dotfiles] oh-my-zsh already installed"
	else
		echo "[dotfiles] Installing oh-my-zsh"
		git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "${HOME}/.oh-my-zsh"
	fi

	# zsh config
	echo "[dotfiles] Linking zsh config for Codespaces"
	ln -sf "${DOTFILES_DIR}/.zshrc" "${HOME}/.zshrc"

	# VS Code Ruby LSP config (machine-scoped in Codespaces)
	VSCODE_SETTINGS_DIR="${HOME}/.vscode-remote/data/Machine"
	VSCODE_SETTINGS_FILE="${VSCODE_SETTINGS_DIR}/settings.json"
	echo "[dotfiles] Configuring VS Code machine settings for Ruby LSP"
	mkdir -p "${VSCODE_SETTINGS_DIR}"
	if [[ ! -f "${VSCODE_SETTINGS_FILE}" ]]; then
		echo "{}" > "${VSCODE_SETTINGS_FILE}"
	fi
	if command -v jq >/dev/null 2>&1; then
		tmp_settings="$(mktemp)"
		if jq '. + {
			"rubyLsp.rubyVersionManager.identifier": "custom",
			"rubyLsp.customRubyCommand": "bin/safe-ruby"
		}' "${VSCODE_SETTINGS_FILE}" > "${tmp_settings}"; then
			mv "${tmp_settings}" "${VSCODE_SETTINGS_FILE}"
			echo "[dotfiles] Updated ${VSCODE_SETTINGS_FILE} for Ruby LSP"
		else
			rm -f "${tmp_settings}"
			echo "[dotfiles] Warning: ${VSCODE_SETTINGS_FILE} is not valid JSON; skipping Ruby LSP machine settings update"
		fi
	else
		echo "[dotfiles] Warning: jq not found; skipping Ruby LSP machine settings update"
	fi

	# Atuin
	if command -v atuin >/dev/null 2>&1; then
		echo "[dotfiles] Atuin already installed"
	else
		echo "[dotfiles] Installing Atuin"
		curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh
		source $HOME/.atuin/bin/env
	fi

	if command -v atuin >/dev/null 2>&1; then
		atuin login -u "$ATUIN_USERNAME" -k "$ATUIN_KEY" -p "$ATUIN_PASSWORD"
	else
		echo "[dotfiles] Skipping Atuin login (atuin command missing)"
	fi

	# Copilot agent configuration
	echo "[dotfiles] Setting up Copilot agent configuration"
	if [[ -d "${DOTFILES_DIR}/.github/agents" ]]; then
		mkdir -p "${HOME}/.github/agents"
		cp -r "${DOTFILES_DIR}/.github/agents/"* "${HOME}/.github/agents/"
		echo "[dotfiles] Copied Copilot agent configuration"
	else
		echo "[dotfiles] Warning: ${DOTFILES_DIR}/.github/agents not found, skipping agent config setup"
	fi

	# Install agent skills
	echo "[dotfiles] Installing agent skills"
	"${DOTFILES_DIR}/install-agent-skills"

	# gh-stack
	echo "[dotfiles] Installing gh-stack extension"
	gh extension install github/gh-stack
	echo "[dotfiles] Adding gh-stack aliases"
	gh stack alias
	echo "[dotfiles] Adding gh-stack skill"
	npx skills add github/gh-stack
  
	# Copilot CLI skills
	echo "[dotfiles] Setting up Copilot skills"
	if [[ -d "${DOTFILES_DIR}/.copilot/skills" ]]; then
		mkdir -p "${HOME}/.copilot/skills"
		cp -r "${DOTFILES_DIR}/.copilot/skills/"* "${HOME}/.copilot/skills/"
		echo "[dotfiles] Copied Copilot skills from ${DOTFILES_DIR}/.copilot/skills/"
	else
		echo "[dotfiles] Warning: ${DOTFILES_DIR}/.copilot/skills not found, skipping skills setup"
	fi

	# Copilot instructions
	echo "[dotfiles] Setting up Copilot instructions"
	if [[ -f "${DOTFILES_DIR}/.copilot/copilot-instructions.md" ]]; then
		mkdir -p "${HOME}/.copilot"
		cp "${DOTFILES_DIR}/.copilot/copilot-instructions.md" "${HOME}/.copilot/copilot-instructions.md"
		echo "[dotfiles] Copied copilot-instructions.md"
	else
		echo "[dotfiles] Warning: .copilot/copilot-instructions.md not found, skipping"
	fi

	# Copilot MCP config
	echo "[dotfiles] Setting up Copilot MCP config"
	if [[ -f "${DOTFILES_DIR}/.copilot/mcp-config.json" ]]; then
		mkdir -p "${HOME}/.copilot"
		cp "${DOTFILES_DIR}/.copilot/mcp-config.json" "${HOME}/.copilot/mcp-config.json"
		echo "[dotfiles] Copied mcp-config.json"
	else
		echo "[dotfiles] Warning: .copilot/mcp-config.json not found, skipping"
	fi

	# User agent skills (caveman etc.) — installed fresh from source
	echo "[dotfiles] Installing caveman skills"
	"${DOTFILES_DIR}/install-caveman-skills"

	# Install Copilot coder plugin
	echo "[dotfiles] Installing Copilot coder plugin"
	"${DOTFILES_DIR}/install-copilot-plugin"
fi
